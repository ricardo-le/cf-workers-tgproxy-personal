{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-tgproxy-personal",
  "main": "telegram_webproxy.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "ProxyCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProxyCoordinator"] }],
  "observability": { "enabled": false },
}
